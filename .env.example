# Muhit: local | staging | production
NODE_ENV=local
PORT=3000

# PostgreSQL (docker-compose.yml bilan bir xil)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=xostavar
DB_USER=xostavar
DB_PASSWORD=xostavar
DATABASE_URL=postgres://xostavar:xostavar@localhost:5433/xostavar

# Redis (rate limit / kesh; hozircha ixtiyoriy)
REDIS_URL=redis://localhost:6379

# JWT: ishlab chiqarishda tasodifiy uzun qator (openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Frontend manzillari (CORS), vergul bilan
CORS_ORIGINS=http://localhost:5173

# Demo foydalanuvchilar (admin/1234 ...) faqat local va staging da yaratiladi
SEED_DEMO=true
