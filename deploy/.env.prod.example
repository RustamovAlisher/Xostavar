# Ishlab chiqarish muhiti. Nusxa oling: cp .env.prod.example .env.prod  (fayl gitga tushmaydi)

# PostgreSQL (konteyner ichida; tashqariga port ochilmaydi)
DB_NAME=xostavar
DB_USER=xostavar
DB_PASSWORD=UZOQ_TASODIFIY_PAROL          # openssl rand -hex 24

# JWT: kamida 32 belgi — openssl rand -hex 32
JWT_ACCESS_SECRET=KAMIDA_32_BELGI_TASODIFIY_QATOR
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Birinchi administrator (login: admin) paroli — faqat baza bo'sh bo'lganda ishlatiladi, birinchi kirishda almashtiriladi
ADMIN_PASSWORD=Birinchi-Parol-2026

# Frontend manzili (CORS). Bir xil domen ostida (nginx proxy) bo'lsa shu domen yetarli
CORS_ORIGINS=https://ombor-control.uz

# Frontend konteyneri faqat 127.0.0.1:HTTP_PORT da ochiladi; tashqariga hostdagi Nginx chiqaradi
HTTP_PORT=8700

# Zaxira: kuniga qaysi soatlarda (Toshkent vaqti, bo'sh joy bilan) va necha kun saqlanadi
BACKUP_TIMES=14:00 22:00
BACKUP_KEEP_DAYS=14

# Zaxirani Telegram guruhga yuborish (ixtiyoriy): @BotFather dan token, botni guruhga qo'shing, guruh ID manfiy son
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
