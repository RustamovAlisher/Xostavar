# Hostdagi Nginx uchun: /etc/nginx/sites-available/ombor-control  →  sites-enabled ga symlink
# Avval faqat 80-port blok bilan ishga tushiring, keyin:  sudo certbot --nginx -d ombor-control.uz -d www.ombor-control.uz
server {
    listen 80;
    server_name ombor-control.uz www.ombor-control.uz;
    client_max_body_size 5m;

    location / {
        proxy_pass http://127.0.0.1:8700;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
